{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "arch": "steiger ./src && pnpm run arch:routes",
    "arch:routes": "node ./scripts/check-route-mount.mjs"
  },
  "dependencies": {
    "@casl/ability": "~7.0.1",
    "@casl/react": "~7.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@repo/contracts": "workspace:*",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "better-auth": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "flag-icons": "^7.6.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.78.0",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^17.1.13",
    "react-quill-new": "^3.8.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "10.3.6",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "postcss": "^8.5.33",
    "shadcn": "^4.23.0",
    "steiger": "^0.6.0",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "imports": {
    "#components/*": "./app/shared/ui/*.tsx",
    "#utils": "./app/shared/lib/utils/*.tsx",
    "#ui": "./app/shared/ui/*.tsx",
    "#lib": "./app/shared/lib/*.ts",
    "#hooks": "./app/shared/lib/hooks/*.ts"
  }
}
