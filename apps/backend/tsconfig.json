{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "incremental": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": false
  },
  "include": ["src", "test", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
