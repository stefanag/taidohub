# Environment for backend e2e tests.
#
# Copy to `.env.e2e` (which is gitignored) and adjust the DB URLs if you're
# not using the bundled `docker-compose.e2e.yml`. All three DATABASE_URL
# variables point at the same DB in local dev — Supabase splits them because
# it uses a pooler in production, but for e2e a single connection string is
# fine.
#
# --- Database -----------------------------------------------------------
# Default matches docker-compose.e2e.yml. Change these three if you're
# running against a local Postgres install, a Neon branch, or anything else.
DATABASE_URL=postgres://taidohub:taidohub@localhost:5433/taidohub_e2e
DIRECT_URL=postgres://taidohub:taidohub@localhost:5433/taidohub_e2e
TEST_DATABASE_URL=postgres://taidohub:taidohub@localhost:5433/taidohub_e2e

# --- Auth ---------------------------------------------------------------
# Values below are test-only — do NOT copy them into production.
BETTER_AUTH_SECRET=e2e-test-secret-not-for-production-32b
BETTER_AUTH_URL=http://localhost:3001

# --- CORS ---------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173,http://localhost:8080
WEB_APP_URL=http://localhost:5173

# --- Node ---------------------------------------------------------------
NODE_ENV=test
