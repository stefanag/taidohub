; Stub env for `openapi:generate` only. Sourced via Node's `--env-file`
; BEFORE `--env-file-if-exists=../../.env`, so the real .env (when present
; locally) wins and overrides these placeholders. In CI there's no .env,
; so the stubs alone are loaded — just enough to satisfy EnvSchema so Nest
; can bootstrap. The OpenAPI introspection doesn't actually touch the DB
; or auth, so placeholder values are safe.

NODE_ENV=development
WEB_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
DIRECT_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
BETTER_AUTH_SECRET=placeholder-placeholder-placeholder-placeholder
BETTER_AUTH_URL=http://localhost:3001
