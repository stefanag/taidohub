# Backend env. See the root `.env.example` for the canonical list of variables.
# Copy that file to `.env` at the repo root — Nest's @nestjs/config picks it up
# via `envFilePath: ['../../.env', '.env']` in `config.module.ts`.

# Consumed only by the db:seed script — identity for the sysadmin user.
SYSADMIN_EMAIL=sysadmin@example.com
SYSADMIN_PASSWORD=sysadmin

# Outgoing email. Leave SMTP_HOST unset locally: invitation and reset links are
# then printed to the backend console instead of being sent.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=TaidoHub <noreply@emails.taidohub.se>

# Google sign-in. Leave unset locally unless you have a development OAuth
# client with http://localhost:3001/api/auth/callback/google as redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
