# /opt/taidohub/.env on each server. chmod 600, owned by deploy.
# Generate secrets on the server:
#   openssl rand -hex 24   (POSTGRES_PASSWORD; hex keeps the DB URL valid)
#   openssl rand -hex 32   (BETTER_AUTH_SECRET; different per environment)

# staging.taidohub.se on the staging server, taidohub.se on production.
SITE_DOMAIN=staging.taidohub.se
ACME_EMAIL=admin@taidohub.se
GHCR_OWNER=stefanag

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Swagger UI at /api/docs: true on staging, false on production.
ENABLE_SWAGGER=true

# Offsite backups (restic to a Hetzner Storage Box over SFTP).
# "storagebox" is the Host alias in /root/.ssh/config (see README).
RESTIC_REPOSITORY=sftp:storagebox:taidohub-staging
RESTIC_PASSWORD_FILE=/root/.restic-password
