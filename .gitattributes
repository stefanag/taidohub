# Default: detect text vs binary, store with LF in repo, check out per platform.
* text=auto eol=lf

# Lock files: always LF, never merge interactively.
pnpm-lock.yaml -text merge=binary

# Shell / Docker / Unix configs: always LF (would break on Windows-CRLF in CI).
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
nginx.conf  text eol=lf
*.conf      text eol=lf

# Windows scripts: always CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binaries (do not touch).
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.pdf       binary
