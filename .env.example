# Backend
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:8080,http://localhost:5173
WEB_APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@db.YOUR-PROJECT.supabase.co:5432/postgres
BETTER_AUTH_SECRET=replace-with-32-byte-random-hex
BETTER_AUTH_URL=http://localhost:3001
ENABLE_SWAGGER=true

# Frontend (Vite — exposed at build time)
VITE_API_URL=http://localhost:3001

# Feature flags — JSON object keyed by code, values are booleans.
# Known codes: grading-history, grading-history-verification, instructor-feedback.
# Defaults to all-off; only flags explicitly set to `true` are enabled.
VITE_FEATURE_FLAGS={}
