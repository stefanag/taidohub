{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env",
    "**/.env.*"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/contracts#build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "env": ["NODE_ENV", "VITE_API_URL", "BACKEND_URL"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**", "test-results/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/contracts#build"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "arch": {
      "outputs": []
    },
    "db:generate": {
      "outputs": ["src/infrastructure/database/migrations/**"]
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "openapi:generate": {
      "dependsOn": ["@repo/contracts#build", "^build"],
      "outputs": ["../../packages/contracts/openapi/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
